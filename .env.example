DATA_DIR=./data
HF_DATASET=itsmebatuhan/bluesky-10m-posts-15-languages
N_POSTS=10000
SEED=42
MIN_POST_CHARS=20
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_MAX_TOKENS=128
EMBED_BATCH=64
EMBED_DEVICE=auto
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=posts
UMAP_N_NEIGHBORS=15
UMAP_N_COMPONENTS=5
UMAP_MIN_DIST=0.0
HDBSCAN_MIN_CLUSTER_SIZE=25
HDBSCAN_MIN_SAMPLES=5
LLM_API_KEY=
LLM_BASE_URL=https://containers.verda.com/<deployment>/v1
LLM_MODEL=nemotron-lightning
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=4096
# On truncated output: up to two compact-JSON retries, doubling to this ceiling.
LLM_MAX_TOKENS_CEILING=16384
LLM_CONCURRENCY=8
LLM_TIMEOUT_S=120
# Cold-start budget. Production should keep a warm Verda replica; use 60-120 for a fast health check.
LLM_WARMUP_TIMEOUT_S=900
MIN_ANALYSIS_SIZE=1
# 0 means no limit. The `all` command always labels every detected cloud.
MAX_ANALYZED_CLUSTERS=0
SAMPLE_SIZE=50
RELEVANCE_HIDE_BELOW=0.35
RELEVANCE_FULL_FROM=0.65
ANOMALY_PERCENTILE=90
BURST_WINDOW_MIN=10
NEAR_DUP_JACCARD=0.8
MINHASH_PERM=64
BASELINE_BUCKETS=25,50,200
MIN_CLUSTERS_PER_BUCKET=10
MIN_SAMPLE_FOR_CONFIDENCE=8
SITE_ADDRESS=:80
# Nemotron 3.5 Super VL on Verda: answers the chat and reads attached files, articles and images.
SUPER_LLM_API_KEY=
SUPER_LLM_BASE_URL=https://containers.datacrunch.io/<deployment>/v1
SUPER_LLM_MODEL=nemotron-3.5-super-vl
SUPER_LLM_MAX_TOKENS=4096
SUPER_LLM_TIMEOUT_S=120
# Which model judges a submitted item: lightning (LLM_* above) or super.
CHAT_JUDGE=lightning
CHAT_JUDGE_TIMEOUT_S=20
CHAT_NEIGHBORS=25
CHAT_MAX_ATTACHMENTS=4
CHAT_MAX_ATTACHMENT_MB=4
# Cost guards for the public demo: total chat requests per minute and in parallel.
CHAT_MAX_PER_MINUTE=20
CHAT_CONCURRENCY=2
# Clouds scoring below this review priority are dropped from the map (0 keeps everything).
MIN_REVIEW_PRIORITY=1
LIVE_POSTS_PER_SECOND=120
